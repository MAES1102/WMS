@startuml
title Purchase Request Workflow — Conceptual Domain Model
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #2d7a5c
skinparam ArrowThickness 1.3
skinparam titleFontColor #163d2e
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam class {
  BackgroundColor #e8f2ec
  BorderColor #1f5c44
  FontColor #163d2e
  AttributeFontColor #17212b
  StereotypeFontColor #5a6470
}
skinparam note {
  BackgroundColor #fff8e7
  BorderColor #c9a227
  FontColor #5a4600
}
skinparam legend {
  BackgroundColor #f4f6f8
  BorderColor #9eabb7
  FontColor #17212b
}

class "Workflow Draft" as Draft <<definition>> {
  identity
  mutable configuration
}
class "Workflow Revision" as Revision <<immutable definition>> {
  identity
  revision number
  activated at
}
class "Task Definition" as Task <<immutable definition>> {
  identity
  name
  task type
  attempt bound
}
class Transition <<immutable definition>> {
  condition: SUCCESS | FAILURE | ALWAYS
}
class "Purchase Request" as Request <<business state>> {
  identity
  structured business fields
  request state
}
class "Workflow Run" as Run <<run state>> {
  identity
  mode
  run state
}
class "Execution Cursor" as Cursor <<run state>> {
  current task
  phase
  state version
  terminal decision
}
class "Task Attempt" as Attempt <<run state>> {
  ordinal
  outcome
  failure class
  reason
}
class "Approval Work Item" as WorkItem <<business/run state>> {
  state
}
class "Approval Decision" as Decision <<business/run state>> {
  approve or reject
  note or reason
}
class "Purchase Authorization" as Authorization <<business state>>
class "Internal Notification" as Notification <<business state>>
class "Trace Entry" as Trace <<run state>> {
  run-local position
  observation kind
}

Draft "1" --> "0..*" Revision : activates
Revision "1" *-- "1..*" Task
Revision "1" *-- "0..*" Transition
Transition "0..*" --> "1" Task : from
Transition "0..*" --> "1" Task : to
Revision "1" <-- "0..*" Run : executes
Request "1" <-- "1" Run : processes
Run "1" *-- "1" Cursor
Run "1" *-- "0..*" Attempt
Task "1" <-- "0..*" Attempt : automatic attempt of
Run "1" *-- "0..1" WorkItem
Request "1" <-- "0..1" WorkItem
Task "1" <-- "0..*" WorkItem : human task of
WorkItem "1" *-- "0..1" Decision
Request "1" *-- "0..1" Authorization
Request "1" *-- "0..*" Notification
Run "1" *-- "1..*" Trace

note right of Revision
Activated content never changes.
Runs never reference a mutable draft.
end note

note right of Cursor
Authoritative continuation state.
EventBus memory is not authoritative.
end note

note bottom of WorkItem
At most one item per run + human task.
At most one authoritative decision.
end note

legend
Conceptual UML omits table/column detail while matching implemented ownership.
Definition, run, and purchase request ownership boundaries are distinct.
endlegend
@enduml
