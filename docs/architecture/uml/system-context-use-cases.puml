@startuml
title Purchase Request Workflow — System Context and Use Cases
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #2d7a5c
skinparam ArrowThickness 1.3
skinparam titleFontColor #163d2e
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam usecase {
  BackgroundColor #e8f2ec
  BorderColor #1f5c44
  FontColor #163d2e
}
skinparam actor {
  BackgroundColor #e8f2ec
  BorderColor #1f5c44
  FontColor #163d2e
}
skinparam rectangle {
  BackgroundColor #f4f6f8
  BorderColor #9eabb7
  FontColor #163d2e
}
skinparam note {
  BackgroundColor #fff8e7
  BorderColor #c9a227
  FontColor #5a4600
}
skinparam legend {
  BackgroundColor #f4f6f8
  BorderColor #9eabb7
  FontColor #17212b
}

actor Submitter
actor Approver
actor "Workflow operator" as Operator
actor "Academic evaluator" as Evaluator

rectangle "Request workflow application" {
  usecase "Submit purchase request" as Submit
  usecase "View purchase request status" as Status
  usecase "Review pending purchase request" as Review
  usecase "Approve or reject" as Decide
  usecase "Configure workflow draft" as Configure
  usecase "Validate and activate revision" as Activate
  usecase "Inspect run trace" as Trace
  usecase "Compare execution modes" as Compare
}

Submitter --> Submit
Submitter --> Status
Approver --> Review
Approver --> Decide
Operator --> Configure
Operator --> Activate
Operator --> Trace
Evaluator --> Status
Evaluator --> Trace
Evaluator --> Compare

Decide ..> Review : <<include>>
Activate ..> Configure : <<include>>
Compare ..> Trace : <<include>>

note bottom of Submit
One bounded structured Purchase Request payload.
No payment, external extraction, or external email.
end note

note bottom of Compare
Same revision, input, decision,
and deterministic fault schedule.
end note

legend
Current requirements and final application boundary.
Logical roles only; authentication is outside scope.
endlegend
@enduml
