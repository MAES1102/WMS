@startuml
title Purchase Request Workflow — Component View
skinparam componentStyle rectangle
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #2d7a5c
skinparam ArrowThickness 1.3
skinparam titleFontColor #163d2e
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam component {
  BackgroundColor #e8f2ec
  BorderColor #1f5c44
  FontColor #163d2e
  StereotypeFontColor #5a6470
}
skinparam node {
  BackgroundColor #f4f6f8
  BorderColor #9eabb7
  FontColor #163d2e
}
skinparam database {
  BackgroundColor #d9ede3
  BorderColor #1f5c44
  FontColor #163d2e
}
skinparam actor {
  BackgroundColor #e8f2ec
  BorderColor #1f5c44
  FontColor #163d2e
}
skinparam note {
  BackgroundColor #fff8e7
  BorderColor #c9a227
  FontColor #5a4600
}
skinparam legend {
  BackgroundColor #f4f6f8
  BorderColor #9eabb7
  FontColor #17212b
}

actor "Application users" as Users
component "Browser UI" as Browser <<presentation>>

node "One FastAPI application" {
  component "HTTP boundary" as HTTP <<presentation>>
  component "Definition / purchase request / approval\napplication services" as Services <<application>>
  component "Execution coordinator" as Coordinator <<application>>
  component "Orchestration strategy" as Orchestration <<application>>
  component "Choreography strategy" as Choreography <<application>>
  component "Definition validator" as Validator <<domain>>
  component "Shared step service\nretry policy + resolver" as Step <<domain>>
  component "Closed executor registry" as Executors <<application>>
  component "Run-scoped EventBus" as EventBus <<infrastructure>>
  component "Repositories / unit of work" as Repositories <<infrastructure>>
  component "Deterministic authorization scenario adapter" as Faults <<application adapter>>
}

database "SQLite workflow database" as Database

Users --> Browser
Browser --> HTTP
HTTP --> Services
Services --> Validator
Services --> Coordinator
Coordinator --> Orchestration
Coordinator --> Choreography
Orchestration --> Step
Choreography --> Step
Choreography --> EventBus
Step --> Executors
Executors --> Faults
Services --> Repositories
Coordinator --> Repositories
Step --> Repositories
Repositories --> Database

note right of EventBus
Transient trigger only.
One handler for one active run scope.
No subscriber while waiting.
end note

note bottom of Step
Business failure is not retried.
Only retryable technical failure
below the bound repeats the task.
end note

legend
Dependencies point toward shared policy.
No broker, external workflow engine, or external business service.
Final conceptual components; API paths and class names are omitted for clarity.
endlegend
@enduml
