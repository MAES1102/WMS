@startuml
title Purchase Request Workflow — Shared Task, Retry, Routing, and Waiting Activity
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 10
skinparam ArrowColor #2d7a5c
skinparam ArrowThickness 1.3
skinparam titleFontColor #163d2e
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam activity {
  BackgroundColor #e8f2ec
  BorderColor #1f5c44
  FontColor #163d2e
  DiamondBackgroundColor #fdf3e0
  DiamondBorderColor #c9a227
  DiamondFontColor #5a4600
  StartColor #176b50
  EndColor #ad3026
  ArrowColor #2d7a5c
  ArrowFontColor #17212b
}
skinparam note {
  BackgroundColor #fff8e7
  BorderColor #c9a227
  FontColor #5a4600
}
skinparam legend {
  BackgroundColor #f4f6f8
  BorderColor #9eabb7
  FontColor #17212b
}

start
:Load immutable revision, purchase request,
run, and versioned cursor;

if (Cursor phase READY?) then (no)
  :Return waiting or terminal projection;
  stop
else (yes)
endif

if (Current task HUMAN_APPROVAL?) then (yes)
  :Create or get unique pending work item;
  :Commit purchase request/run WAITING state
  and ordered trace;
  :Release choreography subscription if present;
  stop
else (automatic)
  :Resolve executor by controlled task type;
  :Execute with bounded context;
  :Commit attempt ordinal, outcome,
  failure class, reason, and trace;
endif

if (Retryable technical failure?) then (yes)
  if (Completed attempts below bound?) then (yes)
    :Commit retry observation;
    :Keep same task and READY cursor;
    note right
    Retry selects no graph edge.
    Only automatic tasks enter this path.
    end note
    stop
  else (bound exhausted)
    :Use final FAILURE for routing;
  endif
else (no)
  if (Outcome FAILURE?) then (yes)
    :Business/non-retryable failure
    routes immediately;
  else (SUCCESS)
  endif
endif

if (Matching outcome transition?) then (yes)
  :Select SUCCESS or FAILURE edge;
  :Commit transition + target READY cursor + trace;
  stop
else (no)
  if (ALWAYS transition?) then (yes)
    :Select fallback edge;
    :Commit transition + target READY cursor + trace;
    stop
  else (no)
    if (Final outcome SUCCESS?) then (yes)
      :Commit successful terminal + trace;
    else (FAILURE)
      :Commit unsuccessful terminal + trace;
    endif
    stop
  endif
endif

legend
Approve later supplies SUCCESS; reject supplies FAILURE and is never retried.
Both modes call this shared semantic activity.
All state/trace changes commit before the next control trigger.
endlegend
@enduml
